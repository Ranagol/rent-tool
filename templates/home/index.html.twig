{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
<div class="page">
    <div class="card">
        <h1 class="page-title">Welcome to RentTool</h1>

        {% if user %}
            <p class="page-lead">Welcome, {{ user.email }}!</p>
            <p class="mt-6"><a href="{{ path('app_logout') }}" class="btn btn-danger">Logout</a></p>
        {% else %}
            <p class="page-lead">Please log in to continue.</p>
            <p class="mt-6 flex gap-3">
                <a href="{{ path('app_login') }}" class="btn btn-primary">Login</a>
                <a href="{{ path('app_register') }}" class="btn btn-secondary">Register</a>
            </p>
        {% endif %}
    </div>
</div>
{% endblock %}
