{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1>Welcome to RentTool</h1>
            
            {% if user %}
                <p class="lead">Welcome, {{ user.email }}!</p>
                <p><a href="{{ path('app_logout') }}" class="btn btn-outline-danger">Logout</a></p>
            {% else %}
                <p class="lead">Please log in to continue.</p>
                <p>
                    <a href="{{ path('app_login') }}" class="btn btn-primary">Login</a>
                    <a href="{{ path('app_register') }}" class="btn btn-secondary">Register</a>
                </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

