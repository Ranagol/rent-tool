{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="page-narrow">
    <div class="card">
        <h1 class="page-title mb-6">Login</h1>

        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.password) }}

            <button type="submit" class="btn btn-primary w-full">Login</button>
        {{ form_end(form) }}

        <p class="mt-5 text-sm text-ink-muted">
            Don't have an account? <a href="{{ path('app_register') }}" class="link">Register here</a>
        </p>
    </div>
</div>
{% endblock %}
