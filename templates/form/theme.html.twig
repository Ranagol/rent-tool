{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="form-group">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{% endblock %}

{% block form_label_class -%}
    form-label{% if required %} required{% endif %}
{%- endblock %}

{% block form_widget_simple %}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' form-control' ~ (errors|length ? ' is-invalid' : ''))|trim,
    }) -%}
    {%- if errors|length %}{% set attr = attr|merge({'aria-invalid': 'true'}) %}{% endif -%}
    {{- parent() -}}
{% endblock %}

{% block textarea_widget %}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-control')|trim}) -%}
    {{- parent() -}}
{% endblock %}

{% block choice_widget_collapsed %}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' form-control')|trim}) -%}
    {{- parent() -}}
{% endblock %}

{% block button_widget %}
    {%- set attr = attr|merge({class: (attr.class|default('btn btn-primary'))|trim}) -%}
    {{- parent() -}}
{% endblock %}

{% block form_help %}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="form-help">{{ help }}</p>
    {%- endif -%}
{% endblock %}

{% block form_errors %}
    {%- for error in errors -%}
        <p class="form-error" role="alert">{{ error.message }}</p>
    {%- endfor -%}
{% endblock %}
