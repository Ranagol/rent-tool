{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1>Register</h1>

            {% if form.vars.errors|length > 0 %}
                <div class="alert alert-danger" role="alert">
                    {% for error in form.vars.errors %}
                        {{ error.message }}
                    {% endfor %}
                </div>
            {% endif %}

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, { 'attr': { 'class': 'form-control' } }) }}
                    {% if form.email.vars.errors|length > 0 %}
                        <div class="invalid-feedback d-block" role="alert">
                            {% for error in form.email.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first, { 'attr': { 'class': 'form-control' } }) }}
                    {% if form.plainPassword.first.vars.errors|length > 0 %}
                        <div class="invalid-feedback d-block" role="alert">
                            {% for error in form.plainPassword.first.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    {% if form.plainPassword.vars.errors|length > 0 %}
                        <div class="invalid-feedback d-block" role="alert">
                            {% for error in form.plainPassword.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second, { 'attr': { 'class': 'form-control' } }) }}
                </div>

                <button type="submit" class="btn btn-primary">Register</button>
            {{ form_end(form) }}

            <p class="mt-3">
                Already have an account? <a href="{{ path('app_login') }}">Login here</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}

