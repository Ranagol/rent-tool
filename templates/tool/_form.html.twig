{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.serialNumber) }}
    {{ form_row(form.imageUrl) }}
    {{ form_row(form.dailyRentCost) }}
    {{ form_row(form.status) }}
