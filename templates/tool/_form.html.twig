    {{ form_row(form.comments) }}

    <div class="flex justify-end gap-2">
        <a href="{{ path('app_tool_index') }}" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">{{ button_label|default('Save') }}</button>
    </div>
{{ form_end(form) }}
