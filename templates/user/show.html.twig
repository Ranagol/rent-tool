{% extends 'base.html.twig' %}

{% block title %}{{ user.email }}{% endblock %}

{% block body %}
<div class="page-narrow">
    {% include '_partials/page_header.html.twig' with {title: 'User details'} %}
    <div class="card">
        <dl class="grid grid-cols-3 gap-y-4 text-sm">
            <dt class="font-medium text-ink-muted">ID</dt>
            <dd class="col-span-2">{{ user.id }}</dd>
            <dt class="font-medium text-ink-muted">Email</dt>
            <dd class="col-span-2">{{ user.email }}</dd>
            <dt class="font-medium text-ink-muted">Roles</dt>
            <dd class="col-span-2">
                {% for role in user.roles %}<span class="badge badge-info">{{ role }}</span> {% endfor %}
            </dd>
        </dl>

        <div class="mt-8 flex flex-wrap justify-between gap-2">
            <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Back to list</a>
            <div class="flex gap-2">
                <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-primary">Edit</a>
                {% include '_partials/confirm_dialog.html.twig' with {
                    id: 'delete-user-' ~ user.id,
                    title: 'Delete user?',
                    message: 'This permanently deletes ' ~ user.email ~ '. This cannot be undone.',
                    action: path('app_user_delete', {id: user.id}),
                    token_id: 'delete' ~ user.id
                } %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
