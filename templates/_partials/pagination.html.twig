{# Variables: route, params (current query params), page, pages #}
{% if pages > 1 %}
    <nav class="flex items-center justify-between border-t border-line px-4 py-3 text-sm" aria-label="Pagination">
        <span class="text-ink-muted">Page {{ page }} of {{ pages }}</span>
        <div class="flex gap-2">
            {% if page > 1 %}
                <a class="btn btn-secondary" rel="prev" href="{{ path(route, params|merge({page: page - 1})) }}">Previous</a>
            {% endif %}
            {% if page < pages %}
                <a class="btn btn-secondary" rel="next" href="{{ path(route, params|merge({page: page + 1})) }}">Next</a>
            {% endif %}
        </div>
    </nav>
{% endif %}
