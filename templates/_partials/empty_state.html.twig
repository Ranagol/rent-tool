{# Variables: message, action_url + action_label (optional) #}
<div class="flex flex-col items-center gap-3 px-6 py-12 text-center">
    <div class="flex size-12 items-center justify-center rounded-full bg-brand-50 text-2xl" aria-hidden="true">∅</div>
    <p class="font-medium">{{ message }}</p>
    {% if action_url|default %}
        <a href="{{ action_url }}" class="btn btn-secondary">{{ action_label }}</a>
    {% endif %}
</div>
